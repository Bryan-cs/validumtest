# BBC File — variables de entorno backend
# Copia a `.env` (no commit) y completa los valores. En Railway se configuran en Variables.

# ── Base de datos ─────────────────────────────────────────────────────────────
# Dev: vacío → SQLite local (bbcfile.db)
# Prod: postgresql://user:pass@host:port/dbname (Railway lo inyecta automáticamente)
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Clave de firma JWT (HS256). Obligatoria en prod. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── Superadmin (multi-tenant) ─────────────────────────────────────────────────
# Credenciales del superadministrador del SaaS que se crea al arrancar si no existe.
# Gestiona las organizaciones (tenants) y sus usuarios. NO pertenece a ninguna organización.
# En prod SUPERADMIN_PASS es OBLIGATORIA (sin ella no se crea el superadmin).
# En dev/SQLite, si no se define, se usa superadmin/superadmin1234.
SUPERADMIN_USER=superadmin
SUPERADMIN_PASS=

# Clave de cifrado Fernet para credenciales de portales (módulo Credenciales).
# INDEPENDIENTE de SECRET_KEY: rotar el JWT NO debe perder claves cifradas.
# Si no se define, hace fallback a SECRET_KEY (riesgo: rotación destruye datos).
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
FERNET_KEY=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000
WEB_CONCURRENCY=1

# ── Caché Redis (opcional) ────────────────────────────────────────────────────
# Vacío → caché en memoria (dict). Prod debe usar Redis para invalidación correcta.
REDIS_URL=

# ── Archivos Cloudflare R2 ────────────────────────────────────────────────────
# Vacío → almacenamiento en disco local backend/uploads (falla en Railway efímero).
STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

# ── Monitoreo Sentry (opcional) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# false en el servicio web; true sólo en los servicios cron `bbc-daily` y `bbc-monthly`.
ENABLE_SCHEDULER=false

# ── CORS dev ──────────────────────────────────────────────────────────────────
# Lista separada por comas. En prod se configura Vercel + dominio público.
# CORS_ORIGINS=http://localhost:5173

# Integración con Laura (agente de ventas Messenger)
LAURA_API_URL=https://laura-production-e5fe.up.railway.app
LAURA_ADMIN_KEY=
